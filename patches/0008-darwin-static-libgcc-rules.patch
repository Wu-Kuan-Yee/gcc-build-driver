diff --git a/libgcc/config/t-darwin b/libgcc/config/t-darwin
index 0f65b54a230..1d413a6c434 100644
--- a/libgcc/config/t-darwin
+++ b/libgcc/config/t-darwin
@@ -66,3 +66,12 @@ libheapt_w.a: heap-trampoline_s.o
 
 # Symbols for all the sub-ports.
 SHLIB_MAPFILES = libgcc-std.ver $(srcdir)/config/libgcc-libsystem.ver
+
+# Static-only libgcc still installs the weak emutls and heap-trampoline
+# convenience archives.  Their shared objects are normally generated only
+# for shared libgcc, so provide explicit rules that work for both modes.
+emutls_s.o: $(srcdir)/emutls.c
+	$(gcc_s_compile) -c $< $(vis_hide)
+
+heap-trampoline_s.o: $(srcdir)/config/aarch64/heap-trampoline.c
+	$(gcc_s_compile) -c $< $(vis_hide)
